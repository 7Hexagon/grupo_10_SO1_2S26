    *" $i "*) ;; \
    *) f="$f $i" ;; \
  esac ; \
done ; \
echo $f > tofiles
rm -f bfd-tmp.h
/bin/sh ../../bfd/../move-if-change tofiles ofiles
touch stmp-bfd-h
touch stamp-ofiles
