for i in elf64-x86-64.lo elfxx-x86.lo elf-ifunc.lo elf64.lo elf-sframe.lo elf.lo elflink.lo elf-strtab.lo elf-eh-frame.lo elf-properties.lo dwarf1.lo dwarf2.lo elf32-i386.lo elf32.lo pei-i386.lo peigen.lo cofflink.lo coffgen.lo pe-x86_64.lo pex64igen.lo pei-x86_64.lo elf64-gen.lo elf32-gen.lo plugin.lo cpu-i386.lo  archive64.lo ; do \
