[Unit]
Description=Aegis Auth Lab restricted relay
Requires=aegis-lab-relay.socket
After=aegisd.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/aegis-auth-lab/restricted_relay.py
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
InaccessiblePaths=-/var/lib/aegisd -/var/log/aegisd.log
UMask=0077
